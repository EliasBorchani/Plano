# Copy to .env (gitignored). compose.yaml, the server tests and the web app read it.

# Postgres (compose.yaml) and the server's database password
POSTGRES_PASSWORD=change-me

# dev: enables the fake Apple sign-in ("dev:<name>") and is required for plain-http cookies below
APP_ENV=dev
COOKIE_SECURE=false

# Signs access tokens; at least 32 bytes (generate: openssl rand -base64 48). Required outside dev;
# in dev, empty = a random one per server start (everyone simply gets refreshed tokens after a restart).
JWT_SECRET=
# Optional: access and refresh token lifetimes (s, m, h, d). Defaults 15m and 30d.
# ACCESS_TTL=15m
# REFRESH_TTL=30d

# Google sign-in: OAuth client ID of type "Web application", authorized origin http://localhost:5173
# (Google Cloud console > APIs & Services > Credentials). The same value goes to the server and the web app.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Sign in with Apple (needs a paid Apple Developer account, a Services ID and an HTTPS domain).
# Empty = dev stand-in when APP_ENV=dev, disabled otherwise.
APPLE_SERVICES_ID=
VITE_APPLE_CLIENT_ID=
